{
  "expo": {
    "name": "CVSUFINDS",
    "slug": "cvsufinds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/CvSUFindsLogo.png",
    "scheme": "cvsufinds",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/CvSUFindsLogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sydlog.cvsufinds"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/CvSUFindsLogo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#102217",
          "dark": {
            "backgroundColor": "#102217"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d103d805-22f9-4fa6-9817-ea7eb08e7f55"
      }
    }
  }
}
